{
  "dataset": {
    "type": "Students Dropout",
    "file_path": "data/students_dropout.csv",
    "train_path": "data/students_dropout.csv",
    "test_path": "",
    "target_column": "Target",
    "test_size": 0.2,
    "scale": true,
    "scaler_type": "standard"
  },
  "federation": {
    "n_clients": 2,
    "distribution": "iid",
    "dirichlet_alpha": 0.5
  },
  "model": {
    "n_estimators": 100,
    "alpha": 0.1,
    "split_criterion": "gini",
    "feature_selection": "prob",
    "use_progressive_stopping": true,
    "convergence": 0.002,
    "episode_size": 5
  },
  "aggregation": {
    "strategy": "s7_perclient_f1_pcd",
    "f1_weight": 0.7,
    "pcd_weight": 0.3,
    "convergence": 0.002,
    "episode_size": 5
  },
  "prediction": {
    "local_weight": 0.4,
    "global_weight": 0.6
  },
  "verbose": false,
  "seed": 42
}