{
  "dataset": {
    "type": "Nursery",
    "file_path": "data/nursery.csv",
    "train_path": "",
    "test_path": "",
    "target_column": "class",
    "test_size": 0.2,
    "scale": true,
    "scaler_type": "standard",
    "sep": ","
  },
  "federation": {
    "n_clients": 2,
    "distribution": "iid",
    "dirichlet_alpha": 0.5
  },
  "model": {
    "n_estimators": 250,
    "alpha": 0.1,
    "split_criterion": "gini",
    "feature_selection": "prob",
    "use_progressive_stopping": true,
    "convergence": 0.005,
    "episode_size": 5
  },
  "aggregation": {
    "strategy": "s6_perclient_f1",
    "t_max": 250,
    "f1_weight": 0.5,
    "pcd_weight": 0.5,
    "convergence": 0.005,
    "episode_size": 5,
    "window_size": 5,
    "max_rounds": 20
  },
  "prediction": {
    "local_weight": 0.5,
    "global_weight": 0.5,
    "use_weighted": true
  },
  "verbose": false,
  "seed": 42
}